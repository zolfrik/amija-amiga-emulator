# --- Build output -------------------------------------------------------
target/
*.class

# NB: src/main/resources/version.properties NON va ignorato. E' il template con i
# segnaposto ${project.version}/${build.timestamp}, cioe' un sorgente; il file
# generato e' la sua copia filtrata in target/classes, gia' esclusa da target/.
# Ignorando il template, un checkout pulito (la CI) compila senza, il jar esce
# privo di /version.properties e Version.version() ripiega su "dev".

# --- Materiale NON ridistribuibile, fornito dall'utente -------------------
# Vedi THIRD-PARTY-NOTICES.md §4. Queste cartelle esistono nel repository
# solo come segnaposto con dentro un readme.txt: il contenuto reale non deve
# MAI essere committato.
floppysounds/*
!floppysounds/readme.txt
whdload/*
!whdload/readme.txt

# ROM Kickstart, immagini disco, archivi WHDLoad — mai nel repository.
*.rom
# Unica eccezione: la ROM di avvio AmiJa. Non è un Kickstart, è firmware
# scritto per questo progetto (sorgente in rom/), quindi ridistribuibile.
# L'eccezione è per il singolo file e non allenta la regola sopra, che serve
# a impedire che una ROM Commodore finisca qui per sbaglio.
!src/main/resources/rom/amija.rom
*.adf
*.ipf
*.hdf
*.lha

# --- Dati di runtime ------------------------------------------------------
# Tutti creati dall'emulatore al primo avvio, nessuno va versionato.
amiga.properties
savestate/
whdload-cache/
whdload-saves/
screenshots/
dumps/
*.log

# --- Ambiente di sviluppo -------------------------------------------------
nbactions.xml
nb-configuration.xml
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# --- Crash della JVM ------------------------------------------------------
hs_err_pid*
replay_pid*

# Intermedi generati da romgen/RomBuilder: la ROM impaginata va in
# src/main/resources/rom/, questi tre sono solo passaggi della build
# (version.i lo scrive romgen/RomVersion, che e' dove sta la versione).
rom/splash.bin
rom/font.bin
rom/version.i
