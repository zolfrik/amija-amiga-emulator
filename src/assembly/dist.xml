<?xml version="1.0" encoding="UTF-8"?>
<!--
  Descrittore dello zip di distribuzione: target/AmiJa-<versione>.zip.

  Contiene tutto e solo quello che serve per eseguire l'emulatore dopo aver
  scompattato l'archivio: il jar eseguibile (già completo di LWJGL e delle sue
  natives), i documenti, e le cartelle lette a runtime dalla directory di lavoro.

  NON contiene amiga.properties: alla prima esecuzione AmigaConfig.load() lo
  crea da solo con i valori di default (vedi config/AmigaConfig.java). Spedirne
  uno preconfezionato significherebbe distribuire i percorsi assoluti della
  macchina di build. Per lo stesso motivo mancano savestate/, screenshots/,
  whdload-cache/ e whdload-saves/: le crea l'emulatore quando servono.
-->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>dist</id>
    <formats>
        <format>zip</format>
    </formats>
    <!-- Tutto dentro una cartella AmiJa-<versione>/: scompattando non si sparpaglia
         il contenuto nella directory corrente. -->
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>AmiJa-${project.version}</baseDirectory>

    <files>
        <!-- Il jar prodotto dallo shade plugin (codice + risorse + LWJGL + natives
             per tutte e sei le piattaforme). Non è l'artifact principale del
             progetto — quello resta amija-<versione>.jar — quindi va preso per
             percorso, non con <dependencySets>. -->
        <file>
            <source>${project.build.directory}/AmiJa.jar</source>
            <outputDirectory>.</outputDirectory>
            <fileMode>0644</fileMode>
        </file>
    </files>

    <fileSets>
        <!-- Documenti: licenza, manuale, note sui componenti di terze parti. -->
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>LICENSE</include>
                <include>README.md</include>
                <include>THIRD-PARTY-NOTICES.md</include>
                <include>USER_MANUAL.txt</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <!-- Il logo che README.md mostra in testa, allo stesso percorso relativo che
             ha nel repository: cosi' l'<img> del README funziona sia su GitHub sia
             dallo zip scompattato. Solo questo file, non l'originale da 1024 px. -->
        <fileSet>
            <directory>${project.basedir}/logo</directory>
            <outputDirectory>logo</outputDirectory>
            <includes>
                <include>amija-256.png</include>
            </includes>
            <fileMode>0644</fileMode>
            <directoryMode>0755</directoryMode>
        </fileSet>

        <!-- Pack di shader RetroArch usati dal renderer OpenGL: sono
             ridistribuibili (GPL-2.0-or-later / MIT, vedi THIRD-PARTY-NOTICES.md)
             e vanno letti dalla directory di lavoro, non dal jar.
             Gli <excludes> sono la stessa rete di sicurezza di whdload/ qui
             sotto: bezel/ e Mega_Bezel_Packs/ sono vuote nel repository (il
             Mega Bezel e i pacchetti community se li installa l'utente), ma su
             una macchina dove sono state riempite lo zip non deve ridistribuirle
             — quello Commodore di TheNamec è CC BY-NC-ND 4.0. -->
        <fileSet>
            <directory>${project.basedir}/shaders</directory>
            <outputDirectory>shaders</outputDirectory>
            <excludes>
                <exclude>shaders_slang/bezel/**</exclude>
                <exclude>Mega_Bezel_Packs/**</exclude>
            </excludes>
            <fileMode>0644</fileMode>
            <directoryMode>0755</directoryMode>
        </fileSet>
        <!-- ...tranne il readme che spiega dove installarli a mano. -->
        <fileSet>
            <directory>${project.basedir}/shaders/Mega_Bezel_Packs</directory>
            <outputDirectory>shaders/Mega_Bezel_Packs</outputDirectory>
            <includes>
                <include>readme.txt</include>
            </includes>
            <fileMode>0644</fileMode>
            <directoryMode>0755</directoryMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/blurs</directory>
            <outputDirectory>blurs</outputDirectory>
            <fileMode>0644</fileMode>
            <directoryMode>0755</directoryMode>
        </fileSet>

        <!-- Campioni del meccanismo del drive. Vanno per intero, senza <includes>:
             sono materiale del progetto (sintetizzati, non registrati — vedi
             THIRD-PARTY-NOTICES.md §3), quindi ridistribuibili come gli shader. -->
        <fileSet>
            <directory>${project.basedir}/floppysounds</directory>
            <outputDirectory>floppysounds</outputDirectory>
            <fileMode>0644</fileMode>
            <directoryMode>0755</directoryMode>
        </fileSet>

        <!-- Segnaposto per il materiale che l'utente deve procurarsi da sé: nello
             zip finisce il solo readme.txt che spiega cosa metterci dentro.
             L'<includes> esplicito è una rete di sicurezza: se un giorno questa
             cartella contenesse i file veri (come nel tree privato), lo zip
             continuerebbe a non ridistribuirli. -->
        <fileSet>
            <directory>${project.basedir}/whdload</directory>
            <outputDirectory>whdload</outputDirectory>
            <includes>
                <include>readme.txt</include>
            </includes>
            <fileMode>0644</fileMode>
            <directoryMode>0755</directoryMode>
        </fileSet>
    </fileSets>
</assembly>
